# NextStep — environment template
#
# Copy this file to `.env.local` and fill in the real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored. This file is committed, so it must never contain
# a real secret — placeholders only.


# ─────────────────────────────────────────────────────────────────────────────
# Database (required)
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string. Used by Prisma (`src/lib/prisma.ts`) and by the
# CLI via `prisma.config.ts`.
#
#   Local, zero-setup:  run `npx prisma dev` and paste the URL it prints
#   Hosted:             neon.tech / supabase.com — use the *pooled* URL
#
# Leaving the USER:PASSWORD placeholder in place is detected at startup and
# reported as a clear error rather than an opaque Auth.js "Configuration" error.
DATABASE_URL=""

# Optional. `prisma migrate dev` needs a second, throwaway database to detect
# drift. `npx prisma dev` provides one; hosted Postgres usually does not — in
# that case leave this unset and Prisma creates a temporary one itself.
SHADOW_DATABASE_URL=""


# ─────────────────────────────────────────────────────────────────────────────
# Auth.js / NextAuth v5 (required)
# ─────────────────────────────────────────────────────────────────────────────

# Signs and encrypts the session JWT. Generate a fresh one with:
#     npx auth secret          # writes it for you
#     openssl rand -base64 33  # or paste this output
# Use a *different* value in production than in local dev.
AUTH_SECRET=""

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
#   → Create credentials → OAuth client ID → Web application
#
# Authorised redirect URIs (add both):
#     http://localhost:3001/api/auth/callback/google     ← dev runs on 3001
#     https://YOUR-DOMAIN/api/auth/callback/google       ← production
#
# Auth.js picks these up by name automatically — no provider config needed.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""


# ─────────────────────────────────────────────────────────────────────────────
# Deployment (production only — leave unset for local dev)
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the deployed app. Vercel infers this; set it explicitly on any
# other host so OAuth callbacks are built against the right origin.
# AUTH_URL="https://YOUR-DOMAIN"

# Set to "true" when running behind a reverse proxy that is not Vercel
# (Railway, Render, Fly, Docker + nginx, …). Without it Auth.js refuses to
# trust the forwarded host header.
# AUTH_TRUST_HOST="true"


# ─────────────────────────────────────────────────────────────────────────────
# Not environment variables
# ─────────────────────────────────────────────────────────────────────────────
#
# ALLOWED_EMAIL_DOMAIN ("ternaengg.ac.in") is a compile-time constant in
# `src/lib/constants.ts`, deliberately not an env var — the domain gate is a
# security boundary and should not be changeable by a deploy-time setting.
#
# The Codeforces API (`/api/dsa/external/codeforces`) is public; no key needed.
